# Copy this file to .env and fill in the values you use.
# LLM_PROVIDER: openai | anthropic | ollama
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_TEMPERATURE=0
SSL_VERIFY=true

# Direct OpenAI. Used when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# AIA gateway. Used when LLM_PROVIDER=openai and OPENAI_API_KEY is empty.
# Token request is client-credentials against AIA_GATEWAY_TOKEN_URL.
AIA_GATEWAY_CLIENT_ID=
AIA_GATEWAY_CLIENT_SECRET=
AIA_GATEWAY_BASE_URL=
AIA_GATEWAY_TOKEN_URL=

# RealLM-compatible OpenAI endpoint. Used when the two options above are empty.
REALLM_BASE_URL=
REALLM_API_KEY=

# Used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# aqe run
SPEC_PATH=examples/specs/registration.md
SUT_PORT=8765

# aqe serve
HOST=127.0.0.1
PORT=8000

# Shared engine settings
RUNS_DIR=runs
TARGET_URL=http://127.0.0.1:8765
SANDBOX_IMAGE=aqe-sandbox:local
MAX_RETRIES=1
SPEC_MAX_BYTES=102400
